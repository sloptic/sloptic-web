# sloptic-web environment. Server-side only: NEVER prefix any of these with NEXT_PUBLIC_ (that would
# ship the value into the client bundle, the exact leak Sloptic grades for).
#
# LOADING: both packages read THIS root .env (copy it to .env and fill it in).
#   - web/    -> next.config.mjs loads ../.env ; web/.env.local still overrides for local-only tweaks
#   - worker/ -> config.py loads ../.env ; worker/.env still overrides
# Real environment variables (set in the shell / host) win over both files.

# ---- Supabase (web API: reads/writes grades via the service role; RLS has no public policies) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Postgres (worker: needs raw SQL / FOR UPDATE SKIP LOCKED, so a direct connection) ----
# Auth (accounts). The ANON key is meant to reach the browser, unlike the service-role key above:
# it only ever sees what RLS lets a signed-in account see. Both NEXT_PUBLIC_ vars must also be set in
# Vercel. NEXT_PUBLIC_OAUTH_PROVIDERS lists providers enabled in the Supabase dashboard, so a button
# never appears for a provider that would fail; leave it empty for magic-link only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_OAUTH_PROVIDERS=

DATABASE_URL=

# ---- Whether the site accepts submissions (web) ----
# FAILS CLOSED. A queued grade only finishes if a worker is polling the same database, and the web
# side cannot tell whether one is. Unset, /api/grade returns 503 and the form says so, instead of
# accepting work that never comes back. Set to 1 once a worker is actually running.
GRADING_OPEN=

# ---- Optional (defaults shown) ----
# Web: anonymous submit rate limit (fixed window).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600
# Worker: path to the pinned grader's catalog, and queue poll interval.
CATALOG_DIR=../../sloptic-main/catalog
POLL_INTERVAL_SECONDS=5

# ---- P0 SAFETY GATE (worker) ----
# The egress sandbox + redirect-scoping is NOT implemented. The worker fails closed and refuses to
# grade real targets. Set to 1 ONLY once that chokepoint is done and the host has a network egress deny.
# Volume controls (worker). These cap how much we grade; they are not part of the egress sandbox,
# which caps where we may connect. CHALLENGE_TRIP_STREAK=25 comes from the grader's
# scripts/retry_blocked.py, which relaxed it up from 8 because a real flag is intermittent; the
# passive battery is benign by construction, so challenges should be rare here regardless.
DAILY_GRADE_BUDGET=300
CHALLENGE_TRIP_STREAK=25
CHALLENGE_BACKOFF_SECONDS=172800
STALE_JOB_SECONDS=1800
MAX_ATTEMPTS=3

EGRESS_SANDBOX_READY=

# No LLM key is required: the pinned sloptic grader makes no LLM calls (verified against the clone).

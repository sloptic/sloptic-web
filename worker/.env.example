# OPTIONAL local overrides. The worker reads the monorepo ROOT .env by default (see ../.env.example);
# put shared values there. Use worker/.env only to override a key for this package locally.
# Server-side only.

# Direct Postgres connection to Supabase (Project settings -> Database -> Connection string).
# The worker needs raw SQL (FOR UPDATE SKIP LOCKED), so it connects to Postgres directly, not via PostgREST.
DATABASE_URL=postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres

# Path to the pinned sloptic grader's catalog dir (the sibling clone).
CATALOG_DIR=../../sloptic-main/catalog

# Seconds to wait when the queue is empty before polling again.
POLL_INTERVAL_SECONDS=5

# How many grades run at once, and the hard wall clock on each (seconds, counted from the claim).
# A grade over the deadline is SIGKILLed with its process group and the job is failed, not retried.
MAX_CONCURRENT_GRADES=4
GRADE_TIMEOUT_SECONDS=600

# How many Lighthouse traces may run at once across all concurrent grades. This must match what the
# frozen curve was graded under, which is 3: a different lane width is a different measurement, not a
# more accurate one. Setting it in a shell rc does NOT reach the worker, systemd does not source one.
SLOPTIC_LIGHTHOUSE_SLOTS=3

# P0 SAFETY GATE. The egress sandbox + redirect-scoping is NOT implemented yet (see egress.py).
# Until it is, the worker REFUSES to grade real targets. Set to 1 ONLY when the chokepoint is done
# and the worker host has a network-level egress deny for internal ranges. Leave unset in the meantime.
EGRESS_SANDBOX_READY=

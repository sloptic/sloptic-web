# Worker config. Server-side only.

# Direct Postgres connection to Supabase (Project settings -> Database -> Connection string).
# The worker needs raw SQL (FOR UPDATE SKIP LOCKED), so it connects to Postgres directly, not via PostgREST.
DATABASE_URL=postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres

# Path to the pinned sloptic grader's catalog dir (the sibling clone).
CATALOG_DIR=../../sloptic-main/catalog

# Seconds to wait when the queue is empty before polling again.
POLL_INTERVAL_SECONDS=5

# P0 SAFETY GATE. The egress sandbox + redirect-scoping is NOT implemented yet (see egress.py).
# Until it is, the worker REFUSES to grade real targets. Set to 1 ONLY when the chokepoint is done
# and the worker host has a network-level egress deny for internal ranges. Leave unset in the meantime.
EGRESS_SANDBOX_READY=

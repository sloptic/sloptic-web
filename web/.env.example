# OPTIONAL local overrides. The web package reads the monorepo ROOT .env by default (see ../.env.example);
# put shared values there. Use web/.env.local only to override a key for this package locally.
# Server-side only. NEVER prefix these with NEXT_PUBLIC_ (that ships them to the client bundle).
# Sloptic grades for exactly this leak, so leaking one here would be self-parody.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service-role key (bypasses RLS). Server-side only. The frontend never uses this.
SUPABASE_SERVICE_ROLE_KEY=

# Fixed-window IP rate limit for anonymous grade submissions.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600
